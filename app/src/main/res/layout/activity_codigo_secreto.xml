<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRaizCofre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tela_arcade"
    android:orientation="vertical"
    tools:context=".CodigoSecretoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCofre"
        style="@style/PocketArcade.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/cd_voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="@string/titulo_cofre"
        tools:subtitle="Jogador: Ana" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCofre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCofre"
                style="@style/PocketArcade.Painel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margem_tela">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgCadeado"
                            android:layout_width="@dimen/icone_painel"
                            android:layout_height="@dimen/icone_painel"
                            android:contentDescription="@string/cd_cadeado"
                            android:src="@drawable/img_cadeado" />

                        <TextView
                            android:id="@+id/tvCodigoOculto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margem_tela"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.15"
                            android:text="@string/codigo_oculto"
                            android:textColor="@color/neon_amarelo"
                            android:textSize="@dimen/texto_codigo"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInstrucaoCofre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_media"
                        android:text="@string/instrucao_cofre"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/texto_claro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_pequena"
                        android:baselineAligned="false"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPalpite"
                            style="@style/PocketArcade.CampoTexto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margem_pequena"
                            android:layout_weight="1"
                            android:hint="@string/hint_palpite">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPalpite"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:letterSpacing="0.3"
                                android:maxLength="4"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTentar"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginTop="6dp"
                            android:text="@string/botao_tentar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTentativasRestantes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_pequena"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/neon_ciano"
                        tools:text="8 tentativas restantes" />

                    <!-- Legenda das cores -->
                    <LinearLayout
                        android:id="@+id/layoutLegenda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_media"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLegendaVerde"
                            style="@style/PocketArcade.Pista"
                            android:layout_marginEnd="@dimen/margem_minima"
                            android:background="@drawable/bg_pista_verde"
                            android:text="@string/legenda_verde" />

                        <TextView
                            android:id="@+id/tvLegendaAmarela"
                            style="@style/PocketArcade.Pista"
                            android:layout_marginEnd="@dimen/margem_minima"
                            android:background="@drawable/bg_pista_amarela"
                            android:text="@string/legenda_amarela" />

                        <TextView
                            android:id="@+id/tvLegendaCinza"
                            style="@style/PocketArcade.Pista"
                            android:background="@drawable/bg_pista_cinza"
                            android:text="@string/legenda_cinza" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Conclusão da partida (vitória ou derrota) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConclusaoCofre"
                style="@style/PocketArcade.Painel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margem_media"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/margem_tela">

                    <TextView
                        android:id="@+id/tvConclusaoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold"
                        tools:text="🔓 Cofre aberto!" />

                    <TextView
                        android:id="@+id/tvConclusaoDetalhes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_pequena"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/texto_claro"
                        tools:text="4 tentativas usadas\nTempo: 1 min 05 s\nCódigo: 4271" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNovaPartidaCofre"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margem_media"
                        android:text="@string/botao_nova_partida"
                        app:icon="@drawable/ic_reiniciar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTituloHistorico"
                style="@style/PocketArcade.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margem_tela"
                android:text="@string/titulo_historico" />

            <TextView
                android:id="@+id/tvHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margem_pequena"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/historico_vazio"
                android:textColor="@color/texto_claro"
                android:textSize="@dimen/texto_historico" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/barraNavegacao"
        layout="@layout/barra_navegacao_desafio" />
</LinearLayout>
